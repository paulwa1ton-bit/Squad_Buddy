{
  "expo": {
    "name": "Squad Buddy",
    "slug": "squad-buddy",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "squadbuddy",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.squadbuddy.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Squad Buddy uses the camera to let you set a team photo or badge.",
        "NSPhotoLibraryUsageDescription": "Squad Buddy uses your photo library to let you choose a team photo or badge."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B3D2E"
      },
      "package": "com.squadbuddy.app",
      "permissions": [
        "NOTIFICATIONS",
        "VIBRATE",
        "CAMERA",
        "READ_MEDIA_IMAGES"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B3D2E"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Squad Buddy uses your photo library to let you choose a team photo or badge."
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "resizeMode": "contain",
          "backgroundColor": "#0B3D2E"
        }
      ]
    ],
    "extra": {
      "router": {
        "origin": false
      },
      "firebase": {
        "apiKey": "REPLACE_ME",
        "authDomain": "REPLACE_ME.firebaseapp.com",
        "projectId": "REPLACE_ME",
        "storageBucket": "REPLACE_ME.appspot.com",
        "messagingSenderId": "REPLACE_ME",
        "appId": "REPLACE_ME"
      }
    }
  }
}
